{
  "rules": {
    ".read": false,
    ".write": false,
    "sessions": {
      "$sessionId": {
        ".write": "auth != null && data.child('public').child('teacherId').val() === auth.uid",
        "public": {
          ".read": true,
          ".write": "auth != null && ((!data.exists() && newData.child('teacherId').val() === auth.uid) || data.child('teacherId').val() === auth.uid)"
        },
        "players": {
          ".read": "auth != null && root.child('sessions').child($sessionId).child('public').child('teacherId').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('sessions').child($sessionId).child('public').child('teacherId').val() === auth.uid)"
          }
        },
        "results": {
          ".read": "auth != null && root.child('sessions').child($sessionId).child('public').child('teacherId').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('sessions').child($sessionId).child('players').child($uid).exists()"
          }
        },
        "attempts": {
          ".read": "auth != null && root.child('sessions').child($sessionId).child('public').child('teacherId').val() === auth.uid",
          "$attemptId": {
            ".write": "auth != null && root.child('sessions').child($sessionId).child('players').child(auth.uid).exists()"
          }
        }
      }
    },
    "teacherSessions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
